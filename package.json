{
  "name": "ikmi-cirebon-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "db:seed": "npm run db:seed:dev",
    "db:seed:generate": "node scripts/generate-master-data-seed.mjs",
    "db:seed:dev": "npm run db:seed:generate && tsx prisma/seed.development.ts",
    "db:seed:master": "tsx prisma/seed.master-data.ts",
    "db:seed:export": "tsx prisma/seed.export.ts",
    "backup:daily": "node scripts/database-backup.mjs --mode daily",
    "backup:weekly": "node scripts/database-backup.mjs --mode weekly",
    "backup:restore-test": "node scripts/database-restore-test.mjs",
    "test": "jest --config jest.config.js",
    "test:scoped": "jest --config jest.config.js --runInBand --runTestsByPath",
    "test:coverage": "jest --config jest.config.js --coverage"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^6.4.0",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@upstash/redis": "^1.34.3",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.5.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "isomorphic-dompurify": "^3.19.0",
    "lucide-react": "^0.469.0",
    "next": "^15.3.0",
    "next-auth": "^5.0.0-beta.32",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.53.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.3.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-mock-extended": "^4.0.1",
    "prisma": "^6.4.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.11",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "overrides": {
    "linkify-it": "5.0.2"
  }
}
