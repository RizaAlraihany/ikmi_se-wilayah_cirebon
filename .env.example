# Local development database. Never use a production connection string here.
DATABASE_URL="postgresql://app_user:replace_with_local_database_password@localhost:5432/ikmi_dev?schema=public"
DIRECT_URL="postgresql://app_user:replace_with_local_database_password@localhost:5432/ikmi_dev?schema=public"
POSTGRES_USER=app_user
POSTGRES_PASSWORD=replace_with_local_postgres_password
POSTGRES_DB=ikmi_dev

# Authentication and public application URLs.
AUTH_SECRET=replace_with_a_minimum_32_character_auth_secret
CRON_SECRET=replace_with_a_minimum_32_character_cron_secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
NODE_ENV=development

# Media and cache providers.
CLOUDINARY_CLOUD_NAME=replace_with_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret
UPSTASH_REDIS_REST_URL=https://your-redis-instance.example.com
UPSTASH_REDIS_REST_TOKEN=replace_with_upstash_redis_token

# WhatsApp and Blogger integrations. Leave recipient/target fields blank until configured locally.
FONNTE_TOKEN=replace_with_whatsapp_provider_token
WA_DEBUG=false
ADMIN_KOMDIGI_WA_RECIPIENTS=
ADMIN_KOMDIGI_WA_NUMBERS=
WA_CONTENT_PLAN_TARGET=
WA_GROUP_INVITE_LINK=https://chat.whatsapp.com/replace_with_group_invite_code
BLOGGER_IMPORT_API_KEY=replace_with_blogger_api_key
BLOGGER_IMPORT_BLOG_ID=replace_with_blogger_blog_id

# Development seed safeguards.
ALLOW_DEVELOPMENT_SEED=false
DEV_SEED_PASSWORD=replace_with_development_seed_password
ALLOW_EXPORT_SEED=false
IMPORT_SEED_ADMIN_PASSWORD=replace_with_import_seed_admin_password
ALLOW_MASTER_DATA_SEED=false

# Backup and restore. Use a local/non-production database and private storage only.
BACKUP_DATABASE_URL="postgresql://backup_user:replace_with_local_backup_password@localhost:5432/ikmi_backup"
BACKUP_DIRECTORY=./backups
BACKUP_EXTERNAL_DIRECTORY=
BACKUP_S3_URI=s3://example-private-bucket/ikmi-backups
BACKUP_AWS_ACCESS_KEY_ID=replace_with_backup_access_key_id
BACKUP_AWS_SECRET_ACCESS_KEY=replace_with_backup_secret_access_key
BACKUP_AWS_REGION=us-east-1
BACKUP_DAILY_RETENTION=14
BACKUP_WEEKLY_RETENTION=8
BACKUP_ALERT_WEBHOOK_URL=
BACKUP_SOURCE_FILE=
RESTORE_TEST_DATABASE_URL="postgresql://restore_user:replace_with_local_restore_password@localhost:5433/ikmi_restore_test"
RESTORE_CONFIRM_DATABASE=ikmi_restore_test
RESTORE_CONFIRM_HOST=localhost
RESTORE_REPORT_DIRECTORY=./backups/restore-reports

# Optional executable and diagnostics overrides.
AWS_BIN=aws
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore
PSQL_BIN=psql
PRISMA_LOG_QUERIES=false
IKMI_NEXT_DIST_DIR=.next
