# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-*/
/out/

# production
/build

# Database backups must live in private external storage, never in Git.
/backups/
*.dump
*.backup
*.sql.gz
restore-test-*.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Real environment files stay local. The sanitized example is intentionally commit-eligible.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ⚠️  DATA SENSITIF — JANGAN DI-COMMIT
# File ini berisi data riil anggota IKMI (nama, email, nomor WA, alamat)
# Hanya digunakan secara lokal untuk seeding database
prisma/master-data.generated.ts
prisma/seed.ts

# ============================================
# LOCAL CODEX / DEVELOPMENT FILES
# Tidak di-commit, hanya untuk workspace lokal
# ============================================

/AGENTS.md
/CLAUDE.md
/.codex/
/docs/
